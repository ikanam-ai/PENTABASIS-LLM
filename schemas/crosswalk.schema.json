{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ikanam-ai/PENTA-AI/schemas/crosswalk.schema.json",
  "title": "Карта нормативного источника к PENTA-10",
  "type": "object",
  "required": [
    "schema_version", "crosswalk_id", "status", "construct_source",
    "normative_source", "interpretation_rule", "decree_value_catalog", "mappings", "exclusions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "crosswalk_id": {"type": "string"},
    "status": {"enum": ["interpretive", "expert_reviewed", "frozen"]},
    "construct_source": {"type": "string"},
    "normative_source": {"type": "string"},
    "amendment_source": {"type": ["string", "null"]},
    "interpretation_rule": {"type": "string", "minLength": 40},
    "decree_value_catalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "mappings": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "object",
        "required": ["decree_values", "relation"],
        "properties": {
          "decree_values": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "relation": {"enum": ["contextual_support", "partial_context"]},
          "note": {"type": "string"}
        }
      }
    },
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
