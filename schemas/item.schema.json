{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ikanam-ai/PENTA-AI/schemas/item.schema.json",
  "title": "Ситуация PENTA-AI",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "construct_version",
    "item_id",
    "state",
    "space",
    "language",
    "primary_facet",
    "secondary_facets",
    "task_type",
    "stakes",
    "context",
    "task",
    "protocols",
    "paraphrases",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "construct_version": {"const": "penta-ai-0.1"},
    "item_id": {"type": "string", "pattern": "^penta-(anchor|adaptive)-[a-z_]+-[0-9]{3}$"},
    "state": {"enum": ["draft", "reviewed", "frozen", "released", "superseded"]},
    "space": {"enum": ["anchor", "adaptive"]},
    "language": {"const": "ru"},
    "primary_facet": {"$ref": "#/$defs/facet"},
    "secondary_facets": {
      "type": "array",
      "items": {"$ref": "#/$defs/facet"},
      "uniqueItems": true
    },
    "task_type": {
      "enum": ["advice", "group_coordination", "institutional_decision", "public_explanation"]
    },
    "stakes": {"enum": ["low", "medium", "high"]},
    "context": {"type": "string", "minLength": 40},
    "task": {"type": "string", "minLength": 20},
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "penta_conditioned"],
      "properties": {
        "native": {"$ref": "#/$defs/protocolForm"},
        "penta_conditioned": {
          "allOf": [
            {"$ref": "#/$defs/protocolForm"},
            {
              "type": "object",
              "required": ["supplied_definitions"],
              "properties": {
                "supplied_definitions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["facet", "definition"],
                    "properties": {
                      "facet": {"$ref": "#/$defs/facet"},
                      "definition": {"type": "string", "minLength": 20}
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "paraphrases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paraphrase_id", "context", "task", "semantic_review"],
        "properties": {
          "paraphrase_id": {"type": "integer", "minimum": 1, "maximum": 3},
          "context": {"type": "string", "minLength": 40},
          "task": {"type": "string", "minLength": 20},
          "semantic_review": {"enum": ["pending", "equivalent", "rejected"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoring", "source_ids", "review_ids"],
      "properties": {
        "authoring": {"enum": ["expert", "model_generated", "mixed"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "review_ids": {"type": "array", "items": {"type": "string"}},
        "generator_manifest_id": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "facet": {
      "enum": [
        "person.creation",
        "person.development",
        "family.love",
        "family.trust",
        "society.agreement",
        "society.cooperation",
        "state.strength",
        "state.responsibility",
        "country.unity",
        "country.diversity"
      ]
    },
    "protocolForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "output_contract"],
      "properties": {
        "prompt": {"type": "string", "minLength": 60},
        "output_contract": {"type": "string", "minLength": 10},
        "supplied_definitions": {"type": "array"}
      }
    }
  }
}
